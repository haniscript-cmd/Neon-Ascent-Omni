# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather for Telegram HTML5 Inline Game & Ranked Group Leaderboard
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_GAME_SHORT_NAME: Game short_name registered in @BotFather via /newgame (default: neonascentomni)
TELEGRAM_GAME_SHORT_NAME="neonascentomni"

# PUBLIC_GAME_URL: Public HTTPS URL of the game sent in answerCallbackQuery
PUBLIC_GAME_URL=""
